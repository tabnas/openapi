{
  "about": [
    "Hand-written edge shapes for tools/apidef-preset.cjs. Each shape is one document.",
    "A shape gives `doc` (the whole document), `yaml` (the text as written), or the shorthand:",
    "`v` (2.0, 3.0, 3.1, 3.2 or none; default 3.0), `schemas` (components.schemas, or definitions",
    "under 2.0), `paths` and `extra` (further root members). In the shorthand, `#S/` in any string",
    "stands for `#/components/schemas/`, or `#/definitions/` under 2.0. `note` says what is tested."
  ],
  "shapes": [
    { "name": "plain", "note": "a plain reference, for a baseline", "schemas": { "A": { "$ref": "#S/B" }, "B": { "type": "string" } } },
    { "name": "plain-2.0", "v": "2.0", "schemas": { "A": { "$ref": "#S/B" }, "B": { "type": "string" } } },
    { "name": "plain-3.1", "v": "3.1", "schemas": { "A": { "$ref": "#S/B" }, "B": { "type": "string" } } },
    { "name": "plain-3.2", "v": "3.2", "schemas": { "A": { "$ref": "#S/B" }, "B": { "type": "string" } } },
    { "name": "plain-noversion", "v": "none", "schemas": { "A": { "$ref": "#S/B" }, "B": { "type": "string" } } },
    { "name": "two-sites-one-target", "note": "sharing between two sites", "schemas": { "A": { "$ref": "#S/C" }, "B": { "$ref": "#S/C" }, "C": { "type": "object", "properties": { "x": { "type": "string" } } } } },

    { "name": "root-ref", "note": "a $ref in the root map", "extra": { "$ref": "#S/B" }, "schemas": { "B": { "type": "string" } } },
    { "name": "root-ref-blocks", "note": "a root $ref, and an ordinary reference elsewhere", "extra": { "$ref": "#S/B" }, "schemas": { "A": { "$ref": "#S/B" }, "B": { "type": "string" } } },
    { "name": "root-ref-missing-blocks", "extra": { "$ref": "#S/Nope" }, "schemas": { "A": { "$ref": "#S/B" }, "B": { "type": "string" } } },
    { "name": "root-ref-nonstring", "extra": { "$ref": 1 }, "schemas": { "A": { "$ref": "#S/B" }, "B": { "type": "string" } } },
    { "name": "root-ref-missing", "extra": { "$ref": "#S/Nope" }, "schemas": { "B": { "type": "string" } } },
    { "name": "root-ref-noversion", "v": "none", "extra": { "$ref": "#S/B" }, "schemas": { "B": { "type": "string" } } },
    { "name": "ref-hash", "note": "$ref: '#'", "schemas": { "A": { "$ref": "#" } } },
    { "name": "ref-empty", "note": "$ref: ''", "schemas": { "A": { "$ref": "" } } },
    { "name": "ref-hash-2.0", "v": "2.0", "schemas": { "A": { "$ref": "#" } } },
    { "name": "ref-hash-slash", "note": "#/ names the root's member ''", "extra": { "": { "type": "string" } }, "schemas": { "A": { "$ref": "#/" } } },
    { "name": "ref-hash-slash-missing", "schemas": { "A": { "$ref": "#/" } } },
    { "name": "ref-empty-segments", "note": "#//a", "extra": { "": { "a": { "type": "string" } } }, "schemas": { "A": { "$ref": "#//a" } } },
    { "name": "ref-empty-member", "note": "a member named ''", "schemas": { "": { "type": "string" }, "A": { "$ref": "#S/" } } },
    { "name": "ref-trailing-slash", "schemas": { "B": { "type": "string" }, "A": { "$ref": "#S/B/" } } },

    { "name": "self-uri-3.2", "note": "a same-document reference by the document's own $self", "v": "3.2", "extra": { "$self": "https://example.com/api.json" }, "schemas": { "A": { "$ref": "https://example.com/api.json#/components/schemas/B" }, "B": { "type": "string" } } },
    { "name": "self-relative-3.2", "v": "3.2", "extra": { "$self": "https://example.com/dir/api.json" }, "schemas": { "A": { "$ref": "api.json#/components/schemas/B" }, "B": { "type": "string" } } },
    { "name": "self-uri-3.1", "note": "$self is 3.2 only", "v": "3.1", "extra": { "$self": "https://example.com/api.json" }, "schemas": { "A": { "$ref": "https://example.com/api.json#/components/schemas/B" }, "B": { "type": "string" } } },
    { "name": "self-uri-no-fragment", "v": "3.2", "extra": { "$self": "https://example.com/api.json" }, "schemas": { "A": { "$ref": "https://example.com/api.json" } } },
    { "name": "default-base-uri", "note": "a reference by the fixed URN the package reads a document with no location under", "schemas": { "A": { "$ref": "urn:uuid:0c2b4f0e-8f9d-4c7a-9a52-6d1e3b7a4f10#/components/schemas/B" }, "B": { "type": "string" } } },
    { "name": "relative-other-doc", "schemas": { "A": { "$ref": "other.yaml#/B" } } },
    { "name": "relative-same-name", "schemas": { "A": { "$ref": "./#/components/schemas/B" }, "B": { "type": "string" } } },
    { "name": "query-only", "schemas": { "A": { "$ref": "?x#/components/schemas/B" }, "B": { "type": "string" } } },

    { "name": "pct-slash-fragment", "note": "a fragment starting %2F", "schemas": { "A": { "$ref": "#%2Fcomponents%2Fschemas%2FB" }, "B": { "type": "string" } } },
    { "name": "pct-slash-lower", "schemas": { "A": { "$ref": "#%2fcomponents%2fschemas%2fB" }, "B": { "type": "string" } } },
    { "name": "pct-space", "note": "a percent-encoded member name", "schemas": { "A B": { "type": "string" }, "A": { "$ref": "#S/A%20B" } } },
    { "name": "pct-literal-member", "note": "a member whose name holds a percent sign, referenced as written", "schemas": { "A%20B": { "type": "string" }, "A": { "$ref": "#S/A%20B" } } },
    { "name": "pct-bad", "note": "a percent sign that is not an escape", "schemas": { "100%": { "type": "string" }, "A": { "$ref": "#S/100%" } } },
    { "name": "pct-path-braces", "note": "a path key with braces, encoded", "paths": { "/pets/{id}": { "get": { "responses": { "200": { "description": "ok" } } } }, "/alias": { "$ref": "#/paths/~1pets~1%7Bid%7D" } } },
    { "name": "pct-path-braces-plain", "paths": { "/pets/{id}": { "get": { "responses": { "200": { "description": "ok" } } } }, "/alias": { "$ref": "#/paths/~1pets~1{id}" } } },
    { "name": "pct-encoded-tilde", "schemas": { "a~b": { "type": "string" }, "A": { "$ref": "#S/a%7E0b" } } },
    { "name": "unicode-member", "schemas": { "Été": { "type": "string" }, "A": { "$ref": "#S/Été" } } },
    { "name": "unicode-member-pct", "schemas": { "Été": { "type": "string" }, "A": { "$ref": "#S/%C3%89t%C3%A9" } } },
    { "name": "hash-inside", "schemas": { "a#b": { "type": "string" }, "A": { "$ref": "#S/a#b" } } },
    { "name": "space-member", "schemas": { "A B": { "type": "string" }, "A": { "$ref": "#S/A B" } } },

    { "name": "tilde-0", "schemas": { "a~b": { "type": "string" }, "A": { "$ref": "#S/a~0b" } } },
    { "name": "tilde-1", "schemas": { "a/b": { "type": "string" }, "A": { "$ref": "#S/a~1b" } } },
    { "name": "tilde-01", "schemas": { "a~1b": { "type": "string" }, "A": { "$ref": "#S/a~01b" } } },
    { "name": "tilde-2", "note": "a bad escape, with a member named as written", "schemas": { "a~2b": { "type": "string" }, "A": { "$ref": "#S/a~2b" } } },
    { "name": "tilde-trailing", "schemas": { "a~": { "type": "string" }, "A": { "$ref": "#S/a~" } } },
    { "name": "tilde-2-missing", "schemas": { "A": { "$ref": "#S/a~2b" } } },

    { "name": "index-0", "schemas": { "B": { "allOf": [ { "type": "string" }, { "minLength": 1 } ] }, "A": { "$ref": "#S/B/allOf/0" } } },
    { "name": "index-leading-zero", "schemas": { "B": { "allOf": [ { "type": "string" }, { "minLength": 1 } ] }, "A": { "$ref": "#S/B/allOf/01" } } },
    { "name": "index-dash", "schemas": { "B": { "allOf": [ { "type": "string" } ] }, "A": { "$ref": "#S/B/allOf/-" } } },
    { "name": "index-past-end", "schemas": { "B": { "allOf": [ { "type": "string" } ] }, "A": { "$ref": "#S/B/allOf/1" } } },
    { "name": "index-negative", "schemas": { "B": { "allOf": [ { "type": "string" } ] }, "A": { "$ref": "#S/B/allOf/-1" } } },
    { "name": "index-plus", "schemas": { "B": { "allOf": [ { "type": "string" } ] }, "A": { "$ref": "#S/B/allOf/+0" } } },
    { "name": "index-on-map", "note": "a digit names a member of a map", "schemas": { "B": { "properties": { "0": { "type": "string" } } }, "A": { "$ref": "#S/B/properties/0" } } },

    { "name": "target-list", "schemas": { "B": { "enum": [ "a", "b" ] }, "A": { "$ref": "#S/B/enum" } } },
    { "name": "target-scalar", "schemas": { "B": { "type": "string" }, "A": { "$ref": "#S/B/type" } } },
    { "name": "target-null", "schemas": { "B": { "default": null }, "A": { "$ref": "#S/B/default" } } },
    { "name": "target-list-with-sibling", "schemas": { "B": { "enum": [ "a" ] }, "A": { "$ref": "#S/B/enum", "description": "d" } } },

    { "name": "ref-number", "schemas": { "A": { "$ref": 5 } } },
    { "name": "ref-null", "schemas": { "A": { "$ref": null } } },
    { "name": "ref-bool", "schemas": { "A": { "$ref": true } } },
    { "name": "ref-list", "schemas": { "A": { "$ref": [ "#S/B" ] }, "B": { "type": "string" } } },
    { "name": "ref-map", "note": "a $ref whose value is a map holding a reference", "schemas": { "A": { "$ref": { "$ref": "#S/B" } }, "B": { "type": "string" } } },
    { "name": "ref-map-in-data", "schemas": { "A": { "example": { "$ref": { "$ref": "#S/B" } } }, "B": { "type": "string" } } },
    { "name": "property-named-ref", "note": "a property named $ref, as data", "schemas": { "A": { "properties": { "$ref": { "type": "string" } } } } },
    { "name": "property-named-ref-string", "note": "a map of property names whose $ref member is a string", "schemas": { "A": { "properties": { "$ref": "#S/B", "x": { "type": "string" } } }, "B": { "type": "string" } } },

    { "name": "dialect-unsupported-root", "note": "jsonSchemaDialect names a dialect the package does not support", "v": "3.1", "extra": { "jsonSchemaDialect": "http://json-schema.org/draft-07/schema#" }, "schemas": { "A": { "$ref": "#S/B" }, "B": { "type": "string" } } },
    { "name": "dialect-unsupported-schema", "v": "3.1", "schemas": { "A": { "$schema": "http://json-schema.org/draft-07/schema#", "$ref": "#S/B" }, "B": { "type": "string" } } },
    { "name": "dialect-unsupported-parent", "v": "3.1", "schemas": { "A": { "$schema": "http://json-schema.org/draft-04/schema#", "properties": { "p": { "$ref": "#S/B" } } }, "B": { "type": "string" } } },
    { "name": "dialect-unsupported-param", "note": "a Reference Object under an unsupported root dialect", "v": "3.1", "extra": { "jsonSchemaDialect": "http://json-schema.org/draft-07/schema#" }, "paths": { "/a": { "get": { "parameters": [ { "$ref": "#/components/parameters/P" } ], "responses": { "200": { "description": "ok" } } } } }, "schemas": { "B": { "type": "string" } }, "components": { "parameters": { "P": { "name": "p", "in": "query", "schema": { "$ref": "#S/B" } } } } },
    { "name": "dialect-3.0-ignored", "v": "3.0", "extra": { "jsonSchemaDialect": "http://json-schema.org/draft-07/schema#" }, "schemas": { "A": { "$ref": "#S/B" }, "B": { "type": "string" } } },
    { "name": "dialect-unsupported-noversion", "v": "none", "extra": { "jsonSchemaDialect": "http://json-schema.org/draft-07/schema#" }, "schemas": { "A": { "$ref": "#S/B" }, "B": { "type": "string" } } },
    { "name": "dialect-2020-12", "v": "3.1", "extra": { "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema" }, "schemas": { "A": { "$ref": "#S/B" }, "B": { "type": "string" } } },

    { "name": "dynamicref-alone", "v": "3.1", "schemas": { "A": { "$dynamicRef": "#S/B" }, "B": { "type": "string" } } },
    { "name": "dynamicref-anchor", "v": "3.1", "schemas": { "A": { "$dynamicRef": "#node" }, "B": { "$dynamicAnchor": "node", "type": "string" } } },
    { "name": "dynamicref-beside-ref", "v": "3.1", "schemas": { "A": { "$ref": "#S/B", "$dynamicRef": "#S/C" }, "B": { "type": "string" }, "C": { "type": "integer" } } },
    { "name": "dynamicref-3.0", "v": "3.0", "schemas": { "A": { "$dynamicRef": "#S/B" }, "B": { "type": "string" } } },
    { "name": "recursiveref-alone", "v": "3.1", "schemas": { "A": { "$recursiveRef": "#" } } },
    { "name": "recursiveref-beside-ref", "v": "3.1", "schemas": { "A": { "$ref": "#S/B", "$recursiveRef": "#" }, "B": { "type": "string" } } },

    { "name": "anchor-3.1", "note": "a plain-name fragment naming an $anchor", "v": "3.1", "schemas": { "B": { "$anchor": "bee", "type": "string" }, "A": { "$ref": "#bee" } } },
    { "name": "anchor-3.0", "v": "3.0", "schemas": { "B": { "$anchor": "bee", "type": "string" }, "A": { "$ref": "#bee" } } },
    { "name": "anchor-missing-3.1", "v": "3.1", "schemas": { "A": { "$ref": "#bee" } } },
    { "name": "dynamic-anchor-by-ref", "v": "3.1", "schemas": { "B": { "$dynamicAnchor": "bee", "type": "string" }, "A": { "$ref": "#bee" } } },
    { "name": "id-uri-3.1", "note": "a reference to a schema by its $id", "v": "3.1", "schemas": { "B": { "$id": "https://example.com/b", "type": "string" }, "A": { "$ref": "https://example.com/b" } } },
    { "name": "id-pointer-under-id", "note": "a pointer under an $id, read against that schema", "v": "3.1", "schemas": { "B": { "$id": "https://example.com/b", "properties": { "p": { "type": "string" }, "q": { "$ref": "#/properties/p" } } } } },
    { "name": "id-pointer-under-id-docwide", "note": "a document-wide pointer written inside a schema with an $id", "v": "3.1", "schemas": { "B": { "$id": "https://example.com/b", "properties": { "q": { "$ref": "#/components/schemas/C" } } }, "C": { "type": "string" } } },
    { "name": "id-on-site", "v": "3.1", "schemas": { "A": { "$id": "https://example.com/a", "$ref": "#/components/schemas/C" }, "C": { "type": "string" } } },
    { "name": "id-relative", "v": "3.1", "schemas": { "B": { "$id": "b.json", "type": "string" }, "A": { "$ref": "b.json" } } },
    { "name": "id-3.0-ignored", "v": "3.0", "schemas": { "B": { "$id": "https://example.com/b", "properties": { "q": { "$ref": "#/components/schemas/C" } } }, "C": { "type": "string" } } },
    { "name": "id-in-example", "note": "an $id inside example data is data", "v": "3.1", "schemas": { "B": { "example": { "$id": "https://example.com/e", "q": { "$ref": "#/components/schemas/C" } } }, "C": { "type": "string" } } },
    { "name": "id-noversion", "v": "none", "schemas": { "B": { "$id": "https://example.com/b", "properties": { "q": { "$ref": "#/components/schemas/C" } } }, "C": { "type": "string" } } },

    { "name": "siblings-merge", "schemas": { "A": { "$ref": "#S/B", "description": "mine", "nullable": true }, "B": { "type": "string", "description": "theirs" } } },
    { "name": "siblings-first", "note": "siblings written before the $ref", "schemas": { "A": { "description": "mine", "$ref": "#S/B" }, "B": { "type": "string", "description": "theirs" } } },
    { "name": "siblings-3.1", "v": "3.1", "schemas": { "A": { "$ref": "#S/B", "description": "mine", "allOf": [ { "minLength": 1 } ] }, "B": { "type": "string" } } },
    { "name": "xref-on-target", "schemas": { "A": { "$ref": "#S/B" }, "B": { "type": "string", "x-ref": "written" } } },
    { "name": "xref-on-site", "schemas": { "A": { "x-ref": "written", "$ref": "#S/B" }, "B": { "type": "string" } } },
    { "name": "xref-on-site-missing", "schemas": { "A": { "x-ref": "written", "$ref": "#S/Nope", "type": "string" } } },
    { "name": "xref-both", "schemas": { "A": { "$ref": "#S/B", "x-ref": "site" }, "B": { "x-ref": "target", "type": "string" } } },

    { "name": "proto-sibling", "note": "a sibling named __proto__", "schemas": { "A": { "$ref": "#S/B", "__proto__": { "type": "integer" } }, "B": { "type": "string" } } },
    { "name": "proto-sibling-scalar", "schemas": { "A": { "$ref": "#S/B", "__proto__": "x" }, "B": { "type": "string" } } },
    { "name": "proto-target-member", "schemas": { "A": { "$ref": "#S/B" }, "B": { "type": "string", "__proto__": { "x": 1 } } } },
    { "name": "proto-target", "schemas": { "__proto__": { "type": "string" }, "A": { "$ref": "#S/__proto__" } } },
    { "name": "proto-missing", "schemas": { "A": { "$ref": "#S/__proto__" } } },
    { "name": "constructor-target", "schemas": { "constructor": { "type": "string" }, "A": { "$ref": "#S/constructor" } } },
    { "name": "constructor-missing", "schemas": { "A": { "$ref": "#S/constructor" } } },
    { "name": "tostring-missing", "schemas": { "A": { "$ref": "#S/toString" } } },
    { "name": "hasownproperty-target", "schemas": { "hasOwnProperty": { "type": "string" }, "A": { "$ref": "#S/hasOwnProperty" } } },
    { "name": "proto-sibling-via-alias", "note": "a pointer through a reference with a __proto__ sibling", "schemas": { "A": { "$ref": "#S/B", "__proto__": { "type": "integer" } }, "B": { "type": "object", "properties": { "p": { "type": "string" } } }, "C": { "$ref": "#S/A/properties/p" } } },

    { "name": "chain-forward", "note": "A -> B -> C, each declared before its target", "schemas": { "A": { "$ref": "#S/B" }, "B": { "$ref": "#S/C" }, "C": { "type": "string" } } },
    { "name": "chain-backward", "schemas": { "C": { "type": "string" }, "B": { "$ref": "#S/C" }, "A": { "$ref": "#S/B" } } },
    { "name": "chain-siblings-forward", "schemas": { "A": { "$ref": "#S/B", "description": "a" }, "B": { "$ref": "#S/C", "title": "b" }, "C": { "type": "string" } } },
    { "name": "chain-siblings-backward", "note": "a chain whose middle link is resolved before the head", "schemas": { "C": { "type": "string" }, "B": { "$ref": "#S/C", "title": "b" }, "A": { "$ref": "#S/B", "description": "a" } } },
    { "name": "chain-backward-head-sibling", "schemas": { "C": { "type": "string" }, "B": { "$ref": "#S/C" }, "A": { "$ref": "#S/B", "description": "a" } } },
    { "name": "chain-backward-mid-sibling", "schemas": { "C": { "type": "string" }, "B": { "$ref": "#S/C", "title": "b" }, "A": { "$ref": "#S/B" } } },
    { "name": "chain-missing-end", "schemas": { "A": { "$ref": "#S/B" }, "B": { "$ref": "#S/Nope" } } },
    { "name": "chain-missing-end-backward", "schemas": { "B": { "$ref": "#S/Nope" }, "A": { "$ref": "#S/B" } } },
    { "name": "chain-to-list", "schemas": { "A": { "$ref": "#S/B" }, "B": { "$ref": "#S/C/enum" }, "C": { "enum": [ 1 ] } } },
    { "name": "chain-external-end", "schemas": { "A": { "$ref": "#S/B" }, "B": { "$ref": "other.yaml#/X" } } },

    { "name": "cycle-self", "schemas": { "A": { "$ref": "#S/A" } } },
    { "name": "cycle-self-sibling", "schemas": { "A": { "$ref": "#S/A", "type": "string" } } },
    { "name": "cycle-two", "schemas": { "A": { "$ref": "#S/B" }, "B": { "$ref": "#S/A" } } },
    { "name": "cycle-property", "note": "a schema naming itself through a property", "schemas": { "A": { "type": "object", "properties": { "self": { "$ref": "#S/A" } } } } },
    { "name": "cycle-two-properties", "schemas": { "A": { "properties": { "b": { "$ref": "#S/B" } } }, "B": { "properties": { "a": { "$ref": "#S/A" } } } } },
    { "name": "cycle-list", "schemas": { "A": { "allOf": [ { "$ref": "#S/A" } ] } } },
    { "name": "cycle-items", "schemas": { "A": { "type": "array", "items": { "$ref": "#S/A" } } } },
    { "name": "cycle-through-sibling", "note": "a cycle through a site's own sibling member", "schemas": { "A": { "$ref": "#S/B", "properties": { "a": { "$ref": "#S/A" } } }, "B": { "type": "object" } } },
    { "name": "cycle-sibling-to-site", "schemas": { "A": { "$ref": "#S/B", "properties": { "x": { "type": "string" } } }, "B": { "properties": { "y": { "$ref": "#S/A" } } } } },
    { "name": "cycle-own-member", "note": "P1: a schema that references its own member", "schemas": { "A": { "$ref": "#S/A/properties/p", "properties": { "p": { "type": "string" } } } } },
    { "name": "cycle-own-defs-3.1", "note": "P4: a bundled schema that references its own $defs, and a reference to it", "v": "3.1", "schemas": { "B": { "$ref": "#S/B/$defs/x", "$defs": { "x": { "type": "string" } } }, "C": { "$ref": "#S/B" } } },
    { "name": "cycle-via-ref-member", "schemas": { "A": { "$ref": "#S/B/properties/p" }, "B": { "properties": { "p": { "$ref": "#S/A" } } } } },
    { "name": "cycle-mutual-props-backward", "schemas": { "B": { "properties": { "a": { "$ref": "#S/A" } } }, "A": { "$ref": "#S/B", "description": "x" } } },

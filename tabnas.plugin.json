{
  "$schema": "https://tabnas.dev/schema/plugin.schema.json",
  "name": "@tabnas/openapi",
  "go": "github.com/tabnas/openapi/go",
  "rust": "tabnas-openapi",
  "description": "OpenAPI and Swagger description parsing for the tabnas engine, in YAML or JSON.",
  "base": "@tabnas/jsonic",
  "engine": "@tabnas/parser",
  "specDir": "test/spec",
  "clib": {
    "dir": "go/clib",
    "library": "libtabnasopenapi",
    "abi": "v1",
    "errorCodes": [
      "usage",
      "grammar",
      "handle",
      "internal"
    ]
  },
  "errorCodes": [
    "openapi_root",
    "openapi_stream",
    "openapi_version",
    "openapi_duplicate_key"
  ],
  "docs": "https://tabnas.dev/docs/packages",
  "repository": "https://github.com/tabnas/openapi",
  "versionSource": "ts/package.json"
}

-name: Rust
-
-# Runs on EVERY branch push, not just main, and the path lists are
-# written out twice.
-#
-# Both are deliberate, for the reasons docs.yml records: GitHub Actions
-# has no YAML anchors, so a version sharing one list between the two
-# triggers does not run at all; and restricting `push` to main while
-# leaning on `pull_request` leaves a gate that reaches a pull request
-# green because it never executed.
-on:
-  # `branches` is set explicitly. A `push` trigger that names neither
-  # branches nor tags also matches TAG pushes, and Actions does not
-  # evaluate `paths` for a tag ref -- so without this, release.yml
-  # pushing `ts/v…` and `go/v…` would run this whole gate once per tag,
-  # on a ref where the path filters mean nothing.
-  push:
-    branches: [ '**' ]
-    paths:
-      - 'rs/**'
-      - 'tabnas.plugin.json'
-      - 'test/spec/**'
-      - 'test/petstore/**'
-      - 'ts/src/openapi.ts'
-      - 'ts/package.json'
-      - 'go/openapi.go'
-      - 'DIVERGENCE.md'
-      - 'ci/rust/**'
-      - '.github/workflows/rust.yml'

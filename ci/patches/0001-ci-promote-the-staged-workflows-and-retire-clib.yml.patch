-jobs:
-  rust:
-    runs-on: ubuntu-latest
-    steps:
-      # Checked out into a NAMED directory. rs/Cargo.toml takes the
-      # engine as `path = "../../parser/rs"` (and the json, jsonic and yaml
-      # grammars, the fixture runner and the debug plugin the same way),
-      # which resolves relative to rs/, so the siblings have to sit beside
-      # this checkout rather than inside it. A bare `actions/checkout`
-      # into the workspace root leaves nowhere for them to go.
-      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
-        with:
-          path: openapi
-
-      # Sibling main, not a release: rs/Cargo.toml names these crates by
-      # path (they are on crates.io, but the committed manifest stays
-      # path-only), so this is the only resolution there is. It is also the
-      # one CI already uses for Go, so both ports are measured against the
-      # same engine.
-      - name: Clone the sibling crates
-        run: |
-          git clone --depth 1 https://github.com/tabnas/parser.git parser
-          git clone --depth 1 https://github.com/tabnas/json.git json
-          git clone --depth 1 https://github.com/tabnas/jsonic.git jsonic
-          git clone --depth 1 https://github.com/tabnas/yaml.git yaml
-          git clone --depth 1 https://github.com/tabnas/support.git support
-          git clone --depth 1 https://github.com/tabnas/debug.git debug
-
-      # Pinned to the MSRV in rs/Cargo.toml rather than to `stable`, so
-      # this fails on a change that needs a newer compiler instead of
-      # passing here and breaking for anyone honouring rust-version.
-      # rustup, NOT dtolnay/rust-toolchain: these repos allow only
-      # GitHub-owned and verified-creator actions (allowed_actions:
-      # selected, patterns_allowed: []), so that action is refused before
-      # any job starts -- the run reports startup_failure, which reads as
-      # a broken workflow file rather than a blocked action. The runners
-      # ship rustup, so the action was buying nothing here.
-      #
-      # `default` is what makes the MSRV the toolchain the gate runs
-      # under; installing it alone leaves cargo on the runner's
-      # pre-installed stable.
-      - name: Set up Rust MSRV
-        run: |
-          rustup toolchain install 1.85 --profile minimal --component rustfmt,clippy
-          rustup default 1.85
-
-      # Everything else lives in the script, so this file and a
-      # contributor's local run cannot say different things.
-      - name: Rust gate
-        run: openapi/ci/rust/run.sh

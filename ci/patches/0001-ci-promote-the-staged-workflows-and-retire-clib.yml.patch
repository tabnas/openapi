-    paths:
-      - 'rs/**'
-      - 'tabnas.plugin.json'
-      - 'test/spec/**'
-      - 'test/petstore/**'
-      - 'ts/src/openapi.ts'
-      - 'ts/package.json'
-      - 'go/openapi.go'
-      - 'DIVERGENCE.md'
-      - 'ci/rust/**'
-      - '.github/workflows/rust.yml'
